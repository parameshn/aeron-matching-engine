<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="engine.codec"
                   id="1"
                   version="0"
                   semanticVersion="0.1"
                   description="Matching engine messages"
                   byteOrder="littleEndian">
    <types>
        <composite name="messageHeader" description="Message header">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId"  primitiveType="uint16"/>
            <type name="schemaId"    primitiveType="uint16"/>
            <type name="version"     primitiveType="uint16"/>
        </composite>

        <enum name="OrderSide" encodingType="uint8">
            <validValue name="BUY">0</validValue>
            <validValue name="SELL">1</validValue>
        </enum>

        <enum name="ExecType" encodingType="uint8">
            <validValue name="ACCEPTED">0</validValue>
            <validValue name="TRADE">1</validValue>
            <validValue name="CANCELLED">2</validValue>
            <validValue name="REJECTED">3</validValue>
        </enum>
    </types>

    <sbe:message name="NewOrder" id="1" description="Submit a limit order">
        <field name="orderId"  id="1" type="int64"/>
        <field name="side"     id="2" type="OrderSide"/>
        <field name="price"    id="3" type="int64"/>
        <field name="quantity" id="4" type="int64"/>
    </sbe:message>

    <sbe:message name="CancelOrder" id="2" description="Cancel a resting order">
        <field name="orderId" id="1" type="int64"/>
    </sbe:message>

    <sbe:message name="ExecutionReport" id="3" description="Result of a submit or cancel">
        <field name="type"           id="1" type="ExecType"/>
        <field name="orderId"        id="2" type="int64"/>
        <field name="counterpartyId" id="3" type="int64"/>
        <field name="price"          id="4" type="int64"/>
        <field name="quantity"       id="5" type="int64"/>
    </sbe:message>
</sbe:messageSchema>